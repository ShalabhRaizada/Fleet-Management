# Copy this file to server/.env  (cp .env.example .env)
# The server loads it automatically on startup.

# AI provider — set ONE of these keys (or both). Without either key the
# platform runs on its deterministic rule-based fallback engines.

# Option A: Anthropic Claude (claude-opus-4-8)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Option B: Google Gemini (default model: gemini-2.5-pro)
# GEMINI_API_KEY=your-gemini-key-here
# GEMINI_MODEL=gemini-2.5-pro

# If both keys are set, Claude is used by default. Force a provider with:
# AI_PROVIDER=claude   # or: gemini

# Optional overrides:
# PORT=4000
# DATA_FILE=./data/db.json
