# Copy this file to server/.env  (cp .env.example .env)
# The server loads it automatically on startup.

# Enables the Claude-powered agent layer (claude-opus-4-8).
# Without it, the platform runs on its rule-based fallback engines.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional overrides:
# PORT=4000
# DATA_FILE=./data/db.json
